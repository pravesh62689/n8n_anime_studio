# =============================================================================
# Anime Studio — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# =============================================================================

# --- OpenRouter Free Tier API Keys ---
# Get free keys at https://openrouter.ai/keys
OR_NEMOTRON_KEY=sk-or-v1-your-nemotron-key-here
OR_GEMMA_KEY=sk-or-v1-your-gemma-key-here
OR_NEMOTRON_ULTRA_KEY=sk-or-v1-your-nemotron-ultra-key-here
OR_COHERE_KEY=sk-or-v1-your-cohere-key-here
OR_QWEN_CODER_KEY=sk-or-v1-your-qwen-coder-key-here
OR_QWEN_KEY=sk-or-v1-your-qwen-key-here
OR_LLAMA_KEY=sk-or-v1-your-llama-key-here

# Alternative: single key that applies to the first model tried
# OPENROUTER_API_KEY=sk-or-v1-your-primary-key-here

# --- YouTube Data API v3 (for upload pipeline) ---
# Create at https://console.cloud.google.com → OAuth credentials (Desktop app)
YT_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret

# --- Hugging Face (optional, for Tier 1 real video generation) ---
# HF_DAILY_QUOTA_SECONDS=190
# HF_ESTIMATED_COST_PER_CLIP_SECONDS=70
# HF_QUOTA_STATE_FILE=hf_quota_state.json

# --- RAG Database ---
# RAG_DB_PATH=analytics_rag.db

# --- Originality Guard ---
# ORIGINALITY_SIMILARITY_THRESHOLD=0.87
# ORIGINALITY_LOOKBACK=20

# --- MCP Server (for n8n hybrid mode) ---
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
