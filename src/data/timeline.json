  "story": {
    "title": "Chintu Hathi Aur Magic Rainbow | Moral Story",
    "character": "assets/chintu.jpg",
    "lines": [
      {
        "text": "Ek jungle mein Chintu naam ka chhota hathi rehta tha.",
        "image": "assets/story-s1.jpg",
        "audio": "assets/story-line-0.mp3",
        "duration": 4.704
      },
      {
        "text": "Chintu bahut sad tha, kyunki uska koi friend nahi tha.",
        "image": "assets/story-s2.jpg",
        "audio": "assets/story-line-1.mp3",
        "duration": 5.064
      },
      {
        "text": "Ek din baarish ke baad, sky mein magic rainbow aaya!",
        "image": "assets/story-s3.jpg",
        "audio": "assets/story-line-2.mp3",
        "duration": 4.872
      },
      {
        "text": "Rainbow bola: Chintu, smile karo, sabko hello bolo!",
        "image": "assets/story-s4.jpg",
        "audio": "assets/story-line-3.mp3",
        "duration": 5.064
      },
      {
        "text": "Chintu ne bunny ko bola hello, aur monkey ko bola hi!",
        "image": "assets/story-s5.jpg",
        "audio": "assets/story-line-4.mp3",
        "duration": 4.896
      },
      {
        "text": "Sab bole: wow Chintu, tum kitne friendly ho!",
        "image": "assets/story-s6.jpg",
        "audio": "assets/story-line-5.mp3",
        "duration": 4.584
      },
      {
        "text": "Ab Chintu ke bahut saare friends the, sab khush the!",
        "image": "assets/story-s7.jpg",
        "audio": "assets/story-line-6.mp3",
        "duration": 4.488
      },
      {
        "text": "Moral: Smile karo, hello bolo, friends banao!",
        "image": "assets/story-s8.jpg",
        "audio": "assets/story-line-7.mp3",
        "duration": 4.56
      }
    ]
  }
