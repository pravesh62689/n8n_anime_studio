        "audio": "assets/rhyme-line-4.mp3",
        "duration": 3.504
      },
      {
        "text": "Blue blue paani, chhap chhap paani!",
        "image": "assets/rhyme-water.jpg",
        "audio": "assets/rhyme-line-5.mp3",
        "duration": 3.36
      },
      {
        "text": "Nacho nacho Hathi Raja, nacho nacho re!",
        "image": "assets/rhyme-drum.jpg",
        "audio": "assets/rhyme-line-6.mp3",
        "duration": 4.08
      },
      {
        "text": "Colors ki duniya mein, aao gaao re!",
        "image": "assets/rhyme-rainbow.jpg",
        "audio": "assets/rhyme-line-7.mp3",
        "duration": 3.192
      },
      {
        "text": "Ek do teen chaar, colors hain hazaar!",
